# Radar Editorial extern — setări opționale
PORT=8787
OFICIU_BASE=https://oficiuldestiri.ro
MAX_AGE_MINUTES=120
MAX_TOPICS=24
CACHE_TTL_MS=480000
REQUEST_TIMEOUT_MS=9000

# Opțional: intră pe Google Trends > Trending Now > România > Export > RSS feed
# și lipește aici URL-ul RSS. Poți pune mai multe URL-uri separate prin virgulă.
# GOOGLE_TRENDS_RSS_URLS=https://trends.google.com/....rss

# Opțional: verificare site:oficiuldestiri.ro prin Google Programmable Search
# GOOGLE_CSE_KEY=
# GOOGLE_CSE_ID=

# Opțional: verificare site:oficiuldestiri.ro prin SerpAPI
# SERPAPI_KEY=
